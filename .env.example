# Web 管理密码 (默认 admin)
WEB_PASSWORD=''

# 邮箱服务配置
# "cloudflare" 或 "gptmail"
EMAIL_SERVICE_TYPE=cloudflare

# Cloudflare 邮箱配置
WORKER_DOMAIN=example.com
ADMIN_PASSWORD=''
# 支持多个域名后缀，逗号分隔，注册时轮换选择
EMAIL_DOMAIN="example1.com, example2.com"

# GPTMail 邮箱配置
# 填写可用域名时本地拼接 前缀@域名（多域名逗号分隔轮换），不调用 generate-email，节省额度
# 留空则调用 generate-email 接口由服务端分配
GPTMAIL_DOMAIN=
GPTMAIL_API_KEY=

# 注册密码配置
# 填写固定密码，留空或填写 random 则每次随机生成
REGISTER_PASSWORD=

# 注册间隔，单位秒
REGISTER_INTERVAL=5

# 可选：非交互指定注册数量
REGISTER_COUNT=5

# Turnstile Solver URL，留空则默认 http://127.0.0.1:5072
TURNSTILE_SOLVER_URL=


# 注册机用的代理
PROXY=

# 代理 Feed：远程订阅反向拉取本机代理列表（GET /api/feed/proxies）
# 留空 = 关闭 feed（接口返回 503，不会变成匿名开放）
# 拉取方需带 token：请求头 X-Feed-Token: xxx 或 ?token=xxx
FEED_TOKEN=

# 自动补齐注册（在 web_app.py 进程内按间隔检查「可供给账号数」并补注册）
# 注意：仅支持单进程运行（不要用多 worker 跑 web_app.py，否则会并发写坏 keys/）
AUTO_REGISTER_ENABLED=false
AUTO_REGISTER_INTERVAL=1800
AUTO_REGISTER_TARGET=50
AUTO_REGISTER_MIN_VALID=10
AUTO_REGISTER_MAX_PER_ROUND=20

# GPTMail 公开 key 接口（GPTMAIL_API_KEY 留空时自动获取，进程内缓存 1 小时，不写回 .env）
GPTMAIL_PUBLIC_KEY_URL=https://mail.chatgpt.org.uk/api/public-key-status?reveal=1

# Updated via Web 配置页
MAX_CAPTCHA_FAIL_ROUNDS=3
PROXY_DOWNLOAD_PROTOCOL=http
WEB_HOST=127.0.0.1
WEB_PORT=5080
