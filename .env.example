# Web 管理密码 (默认 admin)
WEB_PASSWORD=''

# 邮箱服务配置
# "cloudflare" 或 "gptmail"
EMAIL_SERVICE_TYPE=cloudflare

# Cloudflare 邮箱配置
WORKER_DOMAIN=example.com
ADMIN_PASSWORD=''
# 支持多个域名后缀，逗号分隔，注册时轮换选择
EMAIL_DOMAIN="example1.com, example2.com"

# GPTMail 邮箱配置
# 填写可用域名时本地拼接 前缀@域名（多域名逗号分隔轮换），不调用 generate-email，节省额度
# 留空则调用 generate-email 接口由服务端分配
GPTMAIL_DOMAIN=
GPTMAIL_API_KEY=

# 注册密码配置
# 填写固定密码，留空或填写 random 则每次随机生成
REGISTER_PASSWORD=

# 注册间隔，单位秒
REGISTER_INTERVAL=5

# 可选：非交互指定注册数量
REGISTER_COUNT=5

# Turnstile Solver URL，留空则默认 http://127.0.0.1:5072
TURNSTILE_SOLVER_URL=


# 注册机用的代理
PROXY=

# Resin remote subscription — full batch success uploads keys/proxies.txt
RESIN_SUBSCRIPTION_URL=https://resin.example.com/api/v1/subscriptions/***
RESIN_API_TOKEN=
RESIN_NAME=ProxyScrape
RESIN_UPDATE_INTERVAL=12h
RESIN_EPHEMERAL_NODE_EVICT_DELAY=72h0m0s
RESIN_ENABLED=true
RESIN_EPHEMERAL=false
RESIN_INCREMENTAL_ALIVE_NODES=false

# Updated via Web 配置页
MAX_CAPTCHA_FAIL_ROUNDS=3
PROXY_DOWNLOAD_PROTOCOL=http
WEB_HOST=127.0.0.1
WEB_PORT=5080
